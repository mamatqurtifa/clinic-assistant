# === Google OAuth Credentials (dari Google Cloud Console > Credentials) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect URI HANYA dipakai untuk proses login satu kali (scripts/oauth-login.js)
# Harus didaftarkan juga di Google Cloud Console > Credentials > Authorized redirect URIs
GOOGLE_REDIRECT_URI=http://localhost:4000/oauth2callback

# Kosongkan dulu. Akan otomatis terisi setelah menjalankan: npm run oauth:login
GOOGLE_REFRESH_TOKEN=

# ID calendar yang dipakai clinic. "primary" = calendar utama akun yang login OAuth
GOOGLE_CALENDAR_ID=primary

# Timezone clinic (Indonesia WIB = +07:00, tidak ada perubahan DST)
CLINIC_TIMEZONE=Asia/Jakarta
CLINIC_TZ_OFFSET=+07:00

# Port server Express utama (proxy API)
PORT=3000

# Port khusus untuk proses login OAuth satu kali (scripts/oauth-login.js)
OAUTH_LOGIN_PORT=4000
