# === Google OAuth Credentials (dari Google Cloud Console > Credentials) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === App Base URL ===
# URL publik server ini (tanpa trailing slash).
# Dipakai untuk membangun OAUTH_REDIRECT_URI secara otomatis → {APP_BASE_URL}/auth/callback
# Contoh produksi : https://clinic-api.yourdomain.com
# Contoh lokal    : http://localhost:3000  (default jika tidak diisi)
APP_BASE_URL=

# PENTING: Daftarkan juga URL callback di Google Cloud Console >
# Credentials > OAuth 2.0 Client > Authorized redirect URIs:
#   {APP_BASE_URL}/auth/callback
# Contoh: http://localhost:3000/auth/callback

# === Frontend Redirect URL ===
# Kemana user akan diarahkan setelah berhasil login Google?
# Contoh: https://chat.domain.com/settings
FRONTEND_REDIRECT_URL=https://chat.domain.com/settings

# === Google Calendar ===
# ID calendar yang dipakai clinic. "primary" = calendar utama akun yang login.
GOOGLE_CALENDAR_ID=primary

# === Timezone ===
CLINIC_TIMEZONE=Asia/Jakarta
CLINIC_TZ_OFFSET=+07:00

# === Port server Express ===
PORT=3000
